# Modèle de configuration : copier en .env (jamais versionné) puis compléter.

# Moteur d'inférence de l'API : mock | local | vllm
INFERENCE_BACKEND=mock

# Serveur vLLM (moteur vllm). Par défaut : service vllm du profil gpu de Docker Compose.
# VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
VLLM_API_KEY=

# Suivi d'expériences (notebooks d'entraînement)
WANDB_API_KEY=

# Prometheus : cible des métriques vLLM (profil monitoring).
# Par défaut, vLLM local du profil gpu. Pour un pod RunPod :
# VLLM_METRICS_SCHEME=https
# VLLM_METRICS_TARGET=<pod-id>-8000.proxy.runpod.net

# Grafana (profil monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
